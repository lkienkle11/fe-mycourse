{
  "name": "fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node -e \"console.log('No frontend test suite is configured yet.')\"",
    "lint": "eslint",
    "biome": "npm run lint:biome",
    "lint:biome": "biome check .",
    "format:biome": "biome format --write .",
    "lint:commit": "commitlint --from=HEAD~1 --to=HEAD",
    "cycles": "madge --circular --extensions ts,tsx,js,jsx --ts-config ./tsconfig.json src",
    "cycles:json": "madge --circular --extensions ts,tsx,js,jsx --ts-config ./tsconfig.json src --json",
    "dupl": "jscpd src --config .jscpd.json",
    "quality:deps": "npm run cycles && npm run dupl"
  },
