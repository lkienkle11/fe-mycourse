# Frontend MyCourse — copy thành `.env.local` (khuyến nghị) hoặc `.env` rồi chỉnh nếu cần.
# Next.js tự đọc `.env.local` khi chạy `next dev` / `next build`.

# Base URL backend (Gin mặc định SERVER_PORT=8080).
# KHÔNG thêm /api ở cuối: trong code các path đã là /api/v1/...
NEXT_PUBLIC_API_URL=http://localhost:8080

# Tuỳ chọn — chỉ dùng phía server (Server Components, Server Actions, v.v.).
# Trình duyệt không thấy biến này. `src/api/instance.ts` fallback: NEXT_PUBLIC_API_URL → API_URL.
# API_URL=http://localhost:8080

# Chỉ Server Action auth: domain cha để cookie gửi được tới api.<domain> (deploy). Localhost bỏ trống.
# AUTH_COOKIE_DOMAIN=yourdomain.net

# OAuth social sign-in (Google + X). Bỏ trống để tắt provider tương ứng.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID bật nút + One Tap Google; NEXT_PUBLIC_X_CLIENT_ID bật nút X.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_X_CLIENT_ID=
# URL callback X tuyệt đối. PHẢI khớp tuyệt đối với BE X_CALLBACK_URL.
# Localhost: http://localhost:3000/auth/x/callback
NEXT_PUBLIC_X_CALLBACK_URL=
